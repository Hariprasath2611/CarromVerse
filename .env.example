# ============================================================================
# CarromVerse - Environment Variables Configuration
# ============================================================================
# IMPORTANT:
# 1. Do NOT put secret service account keys or private server keys here.
# 2. In Expo, variables prefixed with EXPO_PUBLIC_ are inlined into the client bundle.
# 3. Copy this file to .env and fill in your Firebase project values.
# 4. .env is git-ignored to prevent leaking credentials.
# ============================================================================

# Environment
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# Firebase Client Configuration (From Firebase Console -> Project Settings -> General -> Web App)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere123456789
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=carromverse-game.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=carromverse-game
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=carromverse-game.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
